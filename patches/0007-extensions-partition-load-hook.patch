+#include "extensions/browser/process_manager.h"
@@ -500,1 +502,23 @@
 }
+
+namespace {
+void (*g_enable_extension_for_partition_callback_for_testing)(
+    const std::string&, const std::string&) = nullptr;
+}
+
+void ExtensionService::EnableExtensionForPartition(
+    const std::string& extension_id,
+    const std::string& partition_id) {
+  if (g_enable_extension_for_partition_callback_for_testing) {
+    g_enable_extension_for_partition_callback_for_testing(extension_id, partition_id);
+  }

+  content::StoragePartition* partition =
+      profile_->GetStoragePartitionForConfig(
+          content::StoragePartitionConfig::Create(profile_, "multi_session", partition_id, true));
+  if (partition) {
+    extensions::ProcessManager::Get(profile_)->RegisterStoragePartition(partition);
+  }
+}
+
+void ExtensionService::SetEnableExtensionForPartitionCallbackForTesting(
+    void (*callback)(const std::string&, const std::string&)) {
+  g_enable_extension_for_partition_callback_for_testing = callback;
+}
